# Server Config
PORT=3030
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/news-cms?retryWrites=true&w=majority

# Set to 'true' ONLY in local development to make every OTP "123456".
# Never enable in production (it is ignored when NODE_ENV=production).
ALLOW_STATIC_OTP=false

# Number of proxies (load balancer / CDN hops) in front of the app, e.g. 1.
# Leave unset when running directly without a reverse proxy.
# TRUST_PROXY=1

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_access_key_change_me
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Config (Nodemailer / SMTP or SendGrid)
EMAIL_SERVICE_API_KEY=your_email_api_key
EMAIL_FROM=noreply@newscms.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# SMS Config (Twilio or MSG91)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
